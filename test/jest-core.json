{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@modules/(.*)$": "<rootDir>/modules/$1",
    "^@common/(.*)$": "<rootDir>/common/$1",
    "^@config/(.*)$": "<rootDir>/config/$1",
    "^@firebase/(.*)$": "<rootDir>/firebase/$1"
  },
  "collectCoverageFrom": [
    "modules/{auth,chat,notifications,post,rating,search,user-interest,users}/**/*.controller.ts",
    "modules/{auth,chat,notifications,post,rating,search,user-interest,users}/**/dto/**/*.ts",
    "!modules/**/dto/**/websocket.dto.ts",
    "!**/*.spec.ts"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 70,
      "lines": 70,
      "statements": 70
    }
  },
  "coverageDirectory": "../coverage-core",
  "testEnvironment": "node"
}
